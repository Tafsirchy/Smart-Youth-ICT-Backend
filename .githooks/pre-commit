#!/bin/sh
#
# Pre-commit guard.
#
# Two rules:
#   1. an environment file never enters the history,
#   2. a staged change never carries a credential.
#
# The secret scan needs gitleaks on the PATH. When it is not installed the
# scan is skipped with a message instead of blocking every commit.

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -Eq '(^|/)\.env($|\.)'; then
  echo "Refusing the commit: an environment file is staged." >&2
  echo "Environment files carry live credentials and must stay out of the history." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed - the secret scan was skipped." >&2
  echo "Install it with: winget install Gitleaks.Gitleaks" >&2
  exit 0
fi

gitleaks protect --staged --redact --verbose
